<quiqqer>
    <package>

        <title>
            <locale group="quiqqer/invoice" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/invoice" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="billing.invoices">
                <title>Invoice management</title>
                <description>
                    Creates, posts, delivers and manages invoice drafts and invoices with payment and processing status.
                </description>
            </capability>
            <capability id="billing.credit-notes">
                <title>Credit notes and invoice reversals</title>
                <description>
                    Creates credit notes and reversal invoices from posted invoices.
                </description>
            </capability>
            <capability id="billing.electronic-invoices">
                <title>Electronic invoices</title>
                <description>
                    Generates EN 16931 and ZUGFeRD electronic documents for invoices and credit notes.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/invoice/bin/images/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/invoice/bin/images/preview/preview-1.png"/>
            <image src="URL_OPT_DIR/quiqqer/invoice/bin/images/preview/preview-2.png"/>
            <image src="URL_OPT_DIR/quiqqer/invoice/bin/images/preview/preview-3.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/invoice]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/invoice/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/invoice/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[PCSG QEL-1.0]]></license>
        </copyright>

        <provider>
            <erp src="\QUI\ERP\Accounting\Invoice\ErpProvider"/>
            <erpDemoDataProvider src="\QUI\ERP\Accounting\Invoice\DemoData\InvoiceDemoDataProvider"/>

            <erpOutput src="\QUI\ERP\Accounting\Invoice\Output\OutputProviderInvoice"/>
            <erpOutput src="\QUI\ERP\Accounting\Invoice\Output\OutputProviderCreditNote"/>
            <erpOutput src="\QUI\ERP\Accounting\Invoice\Output\OutputProviderCancelled"/>

            <paymentReceiver src="\QUI\ERP\Accounting\Invoice\PaymentReceiver"/>

            <rest src="\QUI\ERP\Accounting\Invoice\RestApi\Provider"/>

            <mcp src="\QUI\ERP\Accounting\Invoice\McpProvider"/>
        </provider>

    </package>
</quiqqer>
