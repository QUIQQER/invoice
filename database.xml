<?xml version="1.0" encoding="UTF-8"?>
<database>
    <global>
        <table name="invoice">
            <field type="integer" autoincrement="true" primary="true">id</field>
            <field type="string" length="10" nullable="true" default="null">id_prefix</field>
            <field type="string" length="255" nullable="true" default="null">id_with_prefix</field>
            <field type="string" length="50">customer_id</field>
            <field type="string" length="250" nullable="true" default="null">customer_reference</field>
            <field type="string" length="250">hash</field>
            <field type="string" length="250">global_process_id</field>
            <field type="integer">type</field>

            <field type="string" length="255" nullable="true" default="null">order_id</field>
            <field type="string" length="50" nullable="true" default="null">ordered_by</field>
            <field type="datetime" nullable="true" default="null">order_date</field>
            <field type="string" length="200">ordered_by_name</field>
            <field type="string" length="250" nullable="true" default="null">contact_person</field>
            <field type="string" length="250" nullable="true" default="null">project_name</field>
            <field type="timestamp" nullable="true" default="CURRENT_TIMESTAMP">date</field>

            <field type="text" nullable="true" default="null">invoice_address</field>
            <field type="text" nullable="true" default="null">delivery_address</field>
            <field type="text" nullable="true" default="null">service_period</field>

            <field type="string" length="200">payment_method</field>
            <field type="text" nullable="true" default="null">payment_method_data</field>
            <field type="text" nullable="true" default="null">payment_data</field>
            <field type="datetime" nullable="true" default="null">payment_time</field>
            <field type="datetime" nullable="true" default="null">time_for_payment</field>

            <field type="integer">paid_status</field>
            <field type="integer" nullable="true" default="null">paid_date</field>
            <field type="text" nullable="true" default="null">paid_data</field>

            <field type="boolean" nullable="true" default="0">canceled</field>
            <field type="text" nullable="true" default="null">canceled_data</field>
            <field type="string" length="50">c_user</field>
            <field type="timestamp" nullable="true" default="CURRENT_TIMESTAMP">c_date</field>
            <field type="string" length="200">c_username</field>
            <field type="string" length="50" nullable="true" default="null">editor_id</field>
            <field type="string" length="200" nullable="true" default="null">editor_name</field>
            <field type="text" nullable="true" default="null">data</field>
            <field type="text" nullable="true" default="null">additional_invoice_text</field>
            <field type="text" nullable="true" default="null">transaction_invoice_text</field>
            <field type="text">articles</field>
            <field type="text" nullable="true" default="null">history</field>
            <field type="text" nullable="true" default="null">comments</field>
            <field type="text" nullable="true" default="null">custom_data</field>
            <field type="text" nullable="true" default="null">customer_data</field>
            <field type="float">isbrutto</field>

            <field type="text">currency_data</field>
            <field type="string" length="10" nullable="true" default="null">currency</field>

            <field type="float">nettosum</field>
            <field type="float">nettosubsum</field>
            <field type="float">subsum</field>
            <field type="float">sum</field>
            <field type="text">vat_array</field>

            <field type="integer" nullable="true" default="null">shipping_id</field>
            <field type="text" nullable="true" default="null">shipping_data</field>
            <field type="integer" nullable="true" default="null">processing_status</field>

            <index>customer_id</index>
            <index>order_id</index>
            <index>payment_method</index>
            <index>date</index>
            <index>c_date</index>
            <index>hash</index>
            <index>global_process_id</index>
            <index>id_with_prefix</index>
        </table>

